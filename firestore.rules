rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isModerator() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['moderator', 'admin'];
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isBlockedBy(targetUserId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(targetUserId)/blockedUsers/$(request.auth.uid));
    }

    function immutableSensitiveUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'verificationStatus',
        'phoneVerified',
        'selfieVerified',
        'identityVerified',
        'isPremium',
        'role',
        'accountStatus',
        'reportCount'
      ]);
    }

    function validProfessionalVerificationOnCreate() {
      return !request.resource.data.keys().hasAny(['professionalProfile']) ||
        request.resource.data.professionalProfile.isVerified == false;
    }

    function professionalVerificationUnchanged() {
      return !request.resource.data.keys().hasAny(['professionalProfile']) ||
        request.resource.data.professionalProfile.isVerified ==
          (resource.data.keys().hasAny(['professionalProfile'])
            ? resource.data.professionalProfile.isVerified
            : false);
    }

    function validEventOrganizer(eventData) {
      return eventData.organizerType == 'privateHost' ||
        (
          userDoc(request.auth.uid).data.accountType == 'professional' &&
          userDoc(request.auth.uid).data.keys().hasAny(['professionalProfile']) &&
          (
            eventData.organizerType == 'professional' ||
            (
              eventData.organizerType == 'venue' &&
              userDoc(request.auth.uid).data.professionalProfile.category in ['bar', 'venue']
            )
          )
        );
    }

    function validProfessionalRequest(eventId, requestData) {
      return requestData.kind != 'professionalService' ||
        (
          userDoc(request.auth.uid).data.accountType == 'professional' &&
          userDoc(request.auth.uid).data.keys().hasAny(['professionalProfile']) &&
          requestData.professionalCategory ==
            userDoc(request.auth.uid).data.professionalProfile.category &&
          requestData.professionalCategory in
            get(/databases/$(database)/documents/events/$(eventId)).data.professionalNeeds
        );
    }

    function validEventPracticalDetails(data) {
      return data.entryFeeCents is int
        && data.entryFeeCents >= 0
        && data.illegalSubstancesProhibited == true
        && data.attendance.initialMenCount is int
        && data.attendance.initialWomenCount is int
        && data.attendance.initialOtherCount is int
        && data.attendance.currentMenCount == data.attendance.initialMenCount
        && data.attendance.currentWomenCount == data.attendance.initialWomenCount
        && data.attendance.currentOtherCount == data.attendance.initialOtherCount
        && data.attendance.initialMenCount >= 0
        && data.attendance.initialWomenCount >= 0
        && data.attendance.initialOtherCount >= 0
        && data.attendance.initialMenCount
          + data.attendance.initialWomenCount
          + data.attendance.initialOtherCount >= 1
        && data.availableSpots ==
          data.maxParticipants
          - data.attendance.initialMenCount
          - data.attendance.initialWomenCount
          - data.attendance.initialOtherCount;
    }

    match /users/{userId} {
      allow read: if signedIn() && !isBlockedBy(userId);
      allow create: if isUser(userId)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.isPremium == false
        && request.resource.data.role == null
        && validProfessionalVerificationOnCreate();
      allow update: if isUser(userId)
        && immutableSensitiveUserFields()
        && professionalVerificationUnchanged();
      allow delete: if isUser(userId);

      match /swipes/{swipeId} {
        allow read, create, update, delete: if isUser(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isUser(userId);
        allow create: if false;
      }

      match /blockedUsers/{blockedUserId} {
        allow read, create, delete: if isUser(userId);
      }

      match /friends/{friendId} {
        allow read: if isUser(userId);
        // Reciprocal connections are created and removed by the callable
        // setFriendConnection function after block checks.
        allow create, update, delete: if false;
      }
    }

    match /events/{eventId} {
      allow read: if signedIn()
        && resource.data.visibility == 'public'
        && resource.data.status in ['published', 'ongoing', 'full']
        && !isBlockedBy(resource.data.hostId)
        && !('exactAddress' in resource.data);
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && !('exactAddress' in request.resource.data)
        && validEventOrganizer(request.resource.data)
        && validEventPracticalDetails(request.resource.data);
      allow update: if signedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId
        && validEventOrganizer(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'acceptedParticipantIds',
          'waitingParticipantIds',
          'rejectedParticipantIds',
          'availableSpots',
          'attendance',
          'matchCount',
          'requestCount',
          'isBoosted',
          'boostEndDate',
          'illegalSubstancesProhibited'
        ]);
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /private/{privateDoc} {
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid ||
            exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid))
          );
        allow write: if signedIn()
          && get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid;
      }

      match /requests/{requestId} {
        allow read: if signedIn()
          && (resource.data.requesterId == request.auth.uid || resource.data.hostId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.status == 'pending'
          && !isBlockedBy(request.resource.data.hostId)
          && validProfessionalRequest(eventId, request.resource.data)
          && (
            request.resource.data.kind == 'professionalService' ||
            get(/databases/$(database)/documents/events/$(eventId)).data.guestInteractionMode != 'openInterest'
          );
        allow update: if signedIn()
          && resource.data.hostId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']);
        // Withdrawal updates the request and event atomically through a Cloud
        // Function so the host waiting list cannot become stale.
        allow delete: if false;
      }

      match /participants/{participantId} {
        allow read: if signedIn()
          && (participantId == request.auth.uid ||
              get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid);
        allow write: if false;
      }
    }

    match /matches/{matchId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && (!('expiresAt' in get(/databases/$(database)/documents/conversations/$(conversationId)).data)
              || get(/databases/$(database)/documents/conversations/$(conversationId)).data.expiresAt > request.time);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && (!('expiresAt' in get(/databases/$(database)/documents/conversations/$(conversationId)).data)
              || get(/databases/$(database)/documents/conversations/$(conversationId)).data.expiresAt > request.time);
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isModerator());
      allow update, delete: if isModerator();
    }

    match /djProfiles/{djId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isVerified == false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isVerified == resource.data.isVerified;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /djServiceRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.hostId == request.auth.uid || resource.data.djUserId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn() && resource.data.djUserId == request.auth.uid;
      allow delete: if false;
    }

    match /djProposals/{proposalId} {
      allow read: if signedIn()
        && (resource.data.hostId == request.auth.uid || resource.data.djUserId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.djUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /subscriptions/{userId} {
      allow read: if isUser(userId);
      allow write: if false;
    }

    match /boosts/{boostId} {
      allow read: if signedIn() && resource.data.hostId == request.auth.uid;
      allow write: if false;
    }
  }
}
